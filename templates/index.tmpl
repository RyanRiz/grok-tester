{{ define "index.tmpl" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grok Pattern Tester</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body.theme-dark {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #e2e8f0;
        }
        body.theme-dark .bg-white { background-color: #0f172a; }
        body.theme-dark .bg-gray-50 { background-color: #111827; }
        body.theme-dark .bg-gray-100 { background-color: #1f2937; }
        body.theme-dark .text-gray-800 { color: #e2e8f0; }
        body.theme-dark .text-gray-700 { color: #cbd5e1; }
        body.theme-dark .text-gray-600 { color: #94a3b8; }
        body.theme-dark .text-gray-500 { color: #94a3b8; }
        body.theme-dark .text-gray-400 { color: #94a3b8; }
        body.theme-dark .border-gray-200 { border-color: #334155; }
        body.theme-dark .border-gray-300 { border-color: #475569; }
        body.theme-dark .bg-gray-50.text-gray-500 { color: #94a3b8; }
        body.theme-dark .hover\:bg-gray-50:hover { background-color: #1e293b; }
        body.theme-dark .dark-badge { background-color: #92400e; color: #fef3c7; }
        body.theme-dark textarea,
        body.theme-dark input,
        body.theme-dark select {
            background-color: #0b1220;
            color: #e2e8f0;
            border-color: #475569;
        }
        body.theme-dark textarea:focus,
        body.theme-dark input:focus,
        body.theme-dark select:focus {
            border-color: #64748b;
            box-shadow: 0 0 0 2px rgba(100, 116, 139, 0.35);
        }
        body.theme-dark .test-data-shell:focus-within {
            border-color: #64748b;
        }
        body.theme-dark #testData {
            background-color: transparent;
        }
        body.theme-dark textarea::placeholder,
        body.theme-dark input::placeholder {
            color: #64748b;
        }
        body.theme-dark #testDataLineNumbers {
            background-color: #0b1220;
        }
        body.theme-dark #testDataLineNumberContent {
            color: #94a3b8;
        }
    </style>
</head>
<body class="h-screen overflow-hidden bg-gradient-to-br from-indigo-500 via-purple-500 to-purple-600 p-0">
    <div class="w-full h-full bg-white shadow-none rounded-none p-6 lg:p-8 flex flex-col">
        <header class="mb-8 pb-6 border-b-2 border-gray-200">
            <div class="flex items-start justify-between gap-4">
                <div class="flex-1 text-center">
                    <h1 class="text-4xl font-bold text-gray-800 mb-2">Grok Pattern Tester</h1>
                    <p class="text-lg text-gray-600">Test and debug grok patterns</p>
                </div>
                <button id="themeToggle" class="mt-1 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Dark mode</button>
            </div>
        </header>
        
        <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-5 mb-5 flex-1 min-h-0">
            <!-- Left Column: Pattern + Test Data -->
            <div class="flex flex-col gap-5 min-h-0">
                <!-- Grok Pattern -->
                <div class="flex flex-col" style="position: relative;">
                    <div class="flex justify-between items-center mb-2 px-3 py-2 bg-gray-100 rounded-lg">
                        <h2 class="text-lg font-semibold text-gray-800">Grok Pattern</h2>
                        <div class="flex flex-wrap items-center justify-end gap-2">
                            <div class="relative">
                                <button id="patternCopyToggle" class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50 inline-flex items-center gap-1">
                                    Copy
                                    <span class="text-[10px]">▾</span>
                                </button>
                                <div id="patternCopyMenu" class="hidden absolute right-0 mt-1 w-40 rounded-md border border-gray-200 bg-white shadow-lg z-50">
                                    <button id="patternCopyPlain" class="w-full text-left px-3 py-2 text-xs text-gray-700 hover:bg-gray-50">Copy</button>
                                    <button id="patternCopyEscaped" class="w-full text-left px-3 py-2 text-xs text-gray-700 hover:bg-gray-50">Copy escaped</button>
                                </div>
                            </div>
                            <button id="patternAddCustom" class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Add custom</button>
                            <button id="patternEditCustom" class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Edit custom</button>
                            <button id="patternSaveCustom" class="hidden px-2.5 py-1 text-xs font-semibold text-white bg-indigo-600 rounded hover:bg-indigo-500">Save</button>
                            <button id="patternCancelEdit" class="hidden px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Cancel</button>
                            <span id="patternEscapedBadge" class="hidden px-2 py-0.5 text-xs font-semibold rounded-full bg-amber-100 text-amber-700 dark-badge">Escaped</span>
                            <span class="text-sm text-gray-600">Enter your grok pattern</span>
                        </div>
                    </div>
                    <div style="position: relative;">
                        <textarea 
                            id="pattern" 
                            placeholder="Example: %{IP:client} %{WORD:method} %{URIPATHPARAM:request}"
                            spellcheck="false"
                            class="w-full min-h-[120px] p-4 border-2 border-gray-300 rounded-lg font-mono text-sm leading-6 resize-y focus:outline-none focus:border-gray-500 transition-colors"
                        ></textarea>
                        <div id="autocomplete-list" class="hidden absolute left-0 right-0 bg-white border-2 border-indigo-500 border-t-0 rounded-b-lg max-h-[200px] overflow-y-auto z-50 shadow-lg" style="top: 100%; margin-top: -2px;"></div>
                    </div>
                    <div class="mt-2 text-sm text-gray-600">
                        Use %{PATTERN_NAME:field_name} syntax. <a href="/api/patterns" target="_blank" class="text-indigo-600 hover:underline">View available patterns</a>
                    </div>
                </div>
                
                <!-- Test Data -->
                <div class="flex flex-col flex-1 min-h-0">
                    <div class="flex justify-between items-center mb-2 px-3 py-2 bg-gray-100 rounded-lg">
                        <h2 class="text-lg font-semibold text-gray-800">Test Data</h2>
                        <div class="flex items-center gap-2">
                            <button id="testDataCopy" class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Copy</button>
                            <button id="testDataClear" class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Clear</button>
                            <span class="text-sm text-gray-600">Sample log or text to parse</span>
                        </div>
                    </div>
                    <div class="test-data-shell relative flex flex-col flex-1 min-h-0 border-2 border-gray-300 rounded-lg bg-white transition-colors focus-within:border-gray-500 overflow-hidden">
                        <div id="testDataHighlights" class="absolute inset-0 overflow-hidden rounded-lg pointer-events-none">
                            <div id="testDataLineNumbers" class="absolute inset-y-0 left-0 w-12 border-r border-gray-200 bg-white">
                                <div id="testDataLineNumberContent" class="p-4 pr-3 font-mono text-sm leading-6 text-right text-gray-400 whitespace-pre"></div>
                            </div>
                            <div id="testDataHighlightContent" class="p-4 pl-16 font-mono text-sm leading-6 whitespace-pre-wrap break-words text-transparent"></div>
                        </div>
                        <textarea 
                            id="testData" 
                            placeholder="Example: 192.168.1.1 GET /index.html"
                            wrap="soft"
                            spellcheck="false"
                            class="relative z-10 flex-1 w-full min-h-0 p-4 pl-16 font-mono text-sm leading-6 resize-none bg-transparent focus:outline-none overflow-y-auto"
                        ></textarea>
                    </div>
                    <div class="mt-2 text-sm text-gray-600">
                        Paste your log line or text to test against the pattern
                    </div>
                </div>
            </div>
            
            <!-- Right Column: Output -->
            <div class="flex flex-col min-h-0">
                <div class="flex justify-between items-center mb-2 px-3 py-2 bg-gray-100 rounded-lg">
                    <h2 class="text-lg font-semibold text-gray-800">Output</h2>
                    <div class="flex items-center gap-3">
                        <div class="inline-flex rounded-md border border-gray-200 bg-white overflow-hidden">
                            <button id="outputViewTable" class="px-3 py-1 text-xs font-semibold text-gray-700 bg-gray-100">Table</button>
                            <button id="outputViewJson" class="px-3 py-1 text-xs font-semibold text-gray-600 hover:text-gray-800">JSON</button>
                        </div>
                        <button id="outputCopyJson" class="px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Copy JSON</button>
                        <span id="status" class="text-sm font-semibold px-3 py-1 rounded-full bg-blue-100 text-blue-700">Ready</span>
                    </div>
                </div>
                <div id="output" class="flex-1 min-h-0 p-4 border-2 border-gray-300 rounded-lg bg-gray-50 overflow-y-auto font-mono text-sm">
                    <div class="text-gray-500 text-center py-10 italic">
                        Results will appear here automatically as you type...
                    </div>
                </div>
            </div>
        </div>
        
        <footer class="text-center pt-5 border-t-2 border-gray-200 text-gray-600 text-sm">
            <p>Powered by <a href="https://github.com/elastic/go-grok" target="_blank" class="text-indigo-600 hover:underline">elastic/go-grok</a> | 
            Patterns from <a href="https://github.com/cjslack/grok-debugger" target="_blank" class="text-indigo-600 hover:underline">grok-debugger</a></p>
        </footer>
    </div>

    <div id="customPatternModal" class="fixed inset-0 z-50 hidden">
        <div id="customPatternBackdrop" class="absolute inset-0 bg-black/40"></div>
        <div class="relative mx-auto my-6 w-[95%] max-w-3xl bg-white rounded-xl shadow-xl flex flex-col max-h-[85vh]">
            <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800">Custom Patterns</h3>
                <button id="customPatternClose" class="px-3 py-1 text-xs font-semibold text-gray-700 bg-white border border-gray-200 rounded hover:bg-gray-50">Close</button>
            </div>
            <div class="p-5 overflow-y-auto space-y-6">
                <div id="customPatternAddSection">
                    <h4 class="text-sm font-semibold text-gray-700 mb-2">Add new pattern</h4>
                    <div class="grid gap-3">
                        <input id="customPatternName" type="text" placeholder="PATTERN_NAME" class="w-full px-3 py-2 border border-gray-200 rounded font-mono text-xs uppercase focus:outline-none focus:ring-2 focus:ring-gray-200">
                        <p class="text-xs text-gray-500">Uses the current Grok Pattern as the definition.</p>
                        <div class="flex items-center gap-2">
                            <button id="customPatternAdd" class="px-3 py-1 text-xs font-semibold text-white bg-indigo-600 rounded hover:bg-indigo-500">Add</button>
                        </div>
                    </div>
                </div>
                <div id="customPatternListSection">
                    <h4 class="text-sm font-semibold text-gray-700 mb-2">Existing patterns</h4>
                    <div class="border border-gray-200 rounded-lg overflow-hidden">
                        <table class="w-full text-xs">
                            <tbody id="customPatternList"></tbody>
                        </table>
                    </div>
                    <div id="customPatternEmpty" class="text-sm text-gray-500 italic hidden">No custom patterns yet.</div>
                </div>
                <div id="customPatternError" class="text-xs text-red-600 hidden"></div>
            </div>
        </div>
    </div>
    
    <script src="/static/js/app.js"></script>
</body>
</html>
{{ end }}
